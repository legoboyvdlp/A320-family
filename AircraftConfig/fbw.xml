<!-- A3XX Aircraft Config Dialog -->

<PropertyList>

	<name>aircraft-config-fbw</name>
	<layout>vbox</layout>

    <group>
        <layout>hbox</layout>
        <text>
            <halign>left</halign>
            <label>FBW Monitor</label>
        </text>
        <button>
            <halign>right</halign>
            <pref-width>20</pref-width>
            <pref-height>20</pref-height>
            <legend>X</legend>
            <key>Esc</key>
            <binding>
                <command>dialog-close</command>
            </binding>
        </button>
    </group>
	
    <hrule/>

		<!-- Manual FBW law selection -->
	<group>
		<layout>vbox</layout>
		<halign>center</halign>

		<button>
			<pref-width>140</pref-width>
			<pref-height>28</pref-height>
			<legend>NORMAL LAW</legend>
			<binding>
				<command>nasal</command>
				<script>
					setprop("/it-fbw/override", 1);
					setprop("/it-fbw/law", 0);
					setprop("/it-fbw/yaw-law", 0);
				</script>
			</binding>
		</button>

		<button>
			<pref-width>140</pref-width>
			<pref-height>28</pref-height>
			<legend>ALTERNATE LAW</legend>
			<binding>
				<command>nasal</command>
				<script>
					setprop("/it-fbw/override", 1);
					setprop("/it-fbw/law", 1);
					setprop("/it-fbw/yaw-law", 1);
				</script>
			</binding>
		</button>

		<button>
			<pref-width>140</pref-width>
			<pref-height>28</pref-height>
			<legend>DIRECT LAW</legend>
			<binding>
				<command>nasal</command>
				<script>
					setprop("/it-fbw/override", 1);
					setprop("/it-fbw/law", 2);
					setprop("/it-fbw/yaw-law", 2);
				</script>
			</binding>
		</button>

		<button>
			<pref-width>140</pref-width>
			<pref-height>28</pref-height>
			<legend>AUTO / RESET</legend>
			<binding>
				<command>nasal</command>
				<script>
					setprop("/it-fbw/override", 0);
				</script>
			</binding>
		</button>
	</group>

	<hrule/>
	
	<group>
		<layout>hbox</layout>
		<text>
			<label>FBW Output</label>
		</text>
	</group>
	
	<group>
		<layout>vbox</layout>
		
		<group>
			<layout>hbox</layout>

			<hrule>
				<stretch type="bool">true</stretch>
			</hrule>
			<text>
				<label>Roll</label>
			</text>
			<hrule>
				<stretch type="bool">true</stretch>
			</hrule>
		</group>
		
		<group>
			<layout>hbox</layout>
			
			<group>
				<layout>vbox</layout>
				
				<text>
					<label>L:</label>
				</text>
				<slider>
					<pref-height>150</pref-height>
					<vertical>true</vertical>
					<property>/systems/fcs/aileron-l/final-deg</property>
					<min>-25</min>
					<max>25</max>
					<step>0.0025</step>
					<live>true</live>
				</slider>
			</group>
				
			<group>
				<layout>vbox</layout>
				
				<text>
					<label>R:</label>
				</text>
				<slider>
					<pref-height>150</pref-height>
					<vertical>true</vertical>
					<property>/systems/fcs/aileron-r/final-deg</property>
					<min>-25</min>
					<max>25</max>
					<step>0.0025</step>
					<live>true</live>
				</slider>
			</group>
		</group>
		
		<group>
			<layout>hbox</layout>

			<hrule>
				<stretch type="bool">true</stretch>
			</hrule>
			<text>
				<label>Pitch</label>
			</text>
			<hrule>
				<stretch type="bool">true</stretch>
			</hrule>
		</group>
		
		<group>
			<layout>hbox</layout>
			
			<group>
				<layout>vbox</layout>
				
				<text>
					<label>L:</label>
				</text>
				<slider>
					<pref-height>150</pref-height>
					<vertical>true</vertical>
					<property>/systems/fcs/elevator-l/final-deg</property>
					<min>-30</min>
					<max>15</max>
					<step>0.003</step>
					<live>true</live>
				</slider>
			</group>
				
			<group>
				<layout>vbox</layout>
		
				<text>
					<label>Trim:</label>
				</text>
				<slider>
					<pref-height>150</pref-height>
					<vertical>true</vertical>
					<property>/systems/fcs/stabilizer/final-deg</property>
					<min>-12.5</min>
					<max>4</max>
					<step>0.00125</step>
					<live>true</live>
				</slider>
			</group>
			
			<group>
				<layout>vbox</layout>
				
				<text>
					<label>R:</label>
				</text>
				<slider>
					<pref-height>150</pref-height>
					<vertical>true</vertical>
					<property>/systems/fcs/elevator-r/final-deg</property>
					<min>-30</min>
					<max>15</max>
					<step>0.003</step>
					<live>true</live>
				</slider>
			</group>
		</group>
		
		<group>
			<layout>hbox</layout>

			<hrule>
				<stretch type="bool">true</stretch>
			</hrule>
			<text>
				<label>Rudder</label>
			</text>
			<hrule>
				<stretch type="bool">true</stretch>
			</hrule>
		</group>
		
		<group>
			<layout>hbox</layout>
			
			<group>
				<layout>vbox</layout>
				
				<slider>
					<pref-width>150</pref-width>
					<property>/systems/fcs/rudder/final-deg</property>
					<min>-25</min>
					<max>25</max>
					<step>0.0025</step>
					<live>true</live>
				</slider>
			</group>
		</group>
	</group>
	
</PropertyList>
